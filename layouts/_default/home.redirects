{{- range .Site.RegularPages -}}
{{- $target := .Path -}}
{{- range .Page.Aliases -}}
{{ . }} {{ $target }} 301
{{ . }}/ {{ $target }} 301
{{ . }}/index.html {{ $target }} 301
{{ end -}}
{{- end -}}

{{- with $.Site.Home -}}
{{- range .OutputFormats -}}
{{- if eq .Name "atom" -}}
{{ .RelPermalink | replaceRE "/feed\\.xml$" "/rss.xml" }} {{ .RelPermalink }} 301
{{ end -}}
{{- end -}}
{{- end -}}

{{- range $taxonomy, $terms := .Site.Taxonomies -}}
{{- range $term, $pages := $terms -}}
{{- with $.Site.GetPage (printf "/%s/%s/" $taxonomy ($term | urlize)) -}}
{{- range .OutputFormats -}}
{{- if eq .Name "atom" -}}
{{ .RelPermalink | replaceRE "/feed\\.xml$" "/rss.xml" }} {{ .RelPermalink }} 301
{{ end -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- end -}}

/resume /Bj%C3%B6rn%20Lindstr%C3%B6m%20CV.pdf 301
/resume/ /Bj%C3%B6rn%20Lindstr%C3%B6m%20CV.pdf 301
/resume/index.html /Bj%C3%B6rn%20Lindstr%C3%B6m%20CV.pdf 301
